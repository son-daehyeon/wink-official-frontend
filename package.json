{
  "name": "wink-official",
  "version": "1.0.0",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsc --noEmit && next build",
    "start": "next start",
    "dev": "next dev --turbo",
    "openapi:generate": "openapi-typescript http://localhost:8080/v3/api-docs -o src/shared/api/generated/openapi.d.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix"
  },
  "dependencies": {
    "@daypicker/react": "10.0.1",
